<div class="side-card card">
  <div class="card-avatar">
    <%- partial('_partial/avatar') %>
  </div>
  <div class="card-name"><%= config.author %></div>
  <div class="card-desc"><%- markdown(theme.signature) %></div>
  <div class="card-stats">
    <div class="stat">
      <span class="num"><%= site.posts.length %></span>
      <span class="label">文章</span>
    </div>
    <div class="stat">
      <span class="num"><%= site.categories.length %></span>
      <span class="label">分类</span>
    </div>
    <div class="stat">
      <span class="num"><%= site.tags.length %></span>
      <span class="label">标签</span>
    </div>
  </div>
  <% if (theme.social && theme.social.length) { %>
  <div class="card-social">
    <% theme.social.forEach(function(s) { %>
    <a class="social-link" href="<%- s.link %>" target="_blank" rel="noopener" title="<%= s.name %>">
      <i class="fa-brands fa-<%= s.icon %>"></i>
    </a>
    <% }) %>
  </div>
  <% } %>
</div>