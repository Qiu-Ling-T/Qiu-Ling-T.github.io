<header id="header">
  <div class="header-inner">
    <a class="logo" href="<%- url_for('/') %>">
      <span class="logo-icon"><i class="fa-solid fa-paw"></i></span>
      <span class="logo-text"><%= config.title %></span>
    </a>
    <div class="header-right">
      <nav class="nav">
        <a class="nav-link<%= is_home() ? ' active' : '' %>" href="<%- url_for('/') %>">首页</a>
      </nav>
      <div class="search-box" id="search-box">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input id="search-input" type="text" placeholder="搜索文章..." autocomplete="off">
        <div class="search-results" id="search-results"></div>
      </div>
    </div>
  </div>
</header>